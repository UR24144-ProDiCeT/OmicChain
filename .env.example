# Copy this file to ".env" (same folder) and fill in your own values.
# NEVER share or commit your real .env file.

# --- Blockchain access: an RPC endpoint URL per network (e.g. Infura/Alchemy on Base)
INFURA_URL_MAINNET=
INFURA_URL_TESTNET=

# --- Proof contract (Proof.sol) address on each network
CONTRACT_PROOF_ADDRESS_MAINNET=
CONTRACT_PROOF_ADDRESS_TESTNET=

# --- Optional: block in which the contract was deployed (speeds up hash search)
CONTRACT_PROOF_DEPLOY_BLOCK_MAINNET=
CONTRACT_PROOF_DEPLOY_BLOCK_TESTNET=

# --- Publishing account.
# ACCOUNT_ADDRESS is your PUBLIC address (0x...); PRIVATE_KEY is the private key of
# that same address. PRIVATE_KEY is only used to publish and to sign the ORCID link.
ACCOUNT_ADDRESS=
PRIVATE_KEY=

# --- Optional: address where you host the public verification page (see PORTAL.md).
# When set, the certificate's QR code opens that page instead of the block explorer.
OMICCHAIN_VERIFY_URL=

# --- Optional: ORCID identity link (see IDENTITY.md). Register your own ORCID API client
# with this redirect URI: http://127.0.0.1:8765/callback
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# production (default) or sandbox -- test with sandbox first
ORCID_ENV=
# Optional: host of the redirect URI, 127.0.0.1 (default) or localhost
ORCID_REDIRECT_HOST=
# PRODUCTION: ORCID only accepts https:// redirect URIs. Publish portal/orcid-callback.html
# (e.g. on GitHub Pages), register its exact address in the ORCID client, and put it here.
# Leave empty for the sandbox (http://127.0.0.1:8765/callback is then used).
ORCID_REDIRECT_URI=
